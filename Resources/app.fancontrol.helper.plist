<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>app.fancontrol.helper</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/app.fancontrol.helper</string>
	</array>
	<!-- Ties the daemon to the app, so macOS shows it as "Fan Control" (with the app's
	     icon) in Login Items and the "Background Items Added" notification, rather
	     than under the developer's name. Requires both to be signed by the same team. -->
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>app.fancontrol.FanControl</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>app.fancontrol.helper</key>
		<true/>
	</dict>
	<!-- Runs at boot so fans are always handed back to macOS after a crash or restart. -->
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
